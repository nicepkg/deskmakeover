# ── Rust / Cargo ──────────────────────────────────────────────
target/

# ── Web (Bun + Vite) ──────────────────────────────────────────
node_modules/
dist/
dist-ssr/
coverage/
*.local

# ── Tauri (build-time generated ACL schemas, regenerated every build) ──
src-tauri/gen/

# ── Legacy .NET tree (frozen oracle under legacy/, deleted at M8) ──
# bin/ and obj/ are scoped to legacy/ ON PURPOSE: bare `bin/` / `obj/`
# also match Rust `src/bin/`, silently dropping tracked Rust binaries.
legacy/**/bin/
legacy/**/obj/
legacy/**/TestResults/
legacy/**/artifacts/
legacy/**/publish/
# Verify.NET snapshot fixtures are committed — never ignore them.
!legacy/**/Snapshots/**

# ── Local SDK / tooling ───────────────────────────────────────
.dotnet/
.tools/
.cache/

# ── Logs / generated app data ─────────────────────────────────
logs/
*.log
/generated-icons/
/snapshots/

# ── IDE / user files ──────────────────────────────────────────
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# ── OS files ──────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Agent worktrees (git worktree add .worktrees/<task>) ──────
.worktrees/
