{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "bun scripts/fetch-release.mjs && bun scripts/build-images.mjs && bun scripts/subset-zh-font.mjs",
    "dev": "bun scripts/fetch-release.mjs && bun scripts/build-images.mjs && bun scripts/subset-zh-font.mjs && next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "pretypecheck": "bun scripts/fetch-release.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
